{
  "sourceLanguage": "ru",
  "strings": {
    " — приложения «Напрямую» тоже резолвят адреса через VPN. Отдельный DNS будет позже.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " — Direct apps also resolve names through the VPN. Separate DNS is coming later."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " — приложения «Напрямую» тоже резолвят адреса через VPN. Отдельный DNS будет позже."
          }
        }
      }
    },
